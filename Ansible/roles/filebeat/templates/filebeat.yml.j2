# Filebeat configuration for Nginx logs
filebeat.inputs:
- type: log
  enabled: true
  paths:
    - /var/log/nginx/access.log
    - /var/log/nginx/error.log
  fields:
    log_type: nginx
    environment: production
    host: web-server-1.ru-central1.internal
  fields_under_root: true
  scan_frequency: 10s
  close_inactive: 5m
  clean_inactive: 72h
  ignore_older: 24h

output.elasticsearch:
  hosts: ["http://elasticsearch-server.ru-central1.internal:9200"]
  index: "nginx-logs-%{+yyyy.MM.dd}"
  worker: 1
  bulk_max_size: 2048

setup.template:
  name: "nginx-logs"
  pattern: "nginx-logs-*"
  enabled: true
  overwrite: true
  settings:
    index.number_of_shards: 1
    index.number_of_replicas: 0

setup.ilm.enabled: false

processors:
  - add_host_metadata:
      netinfo:
        enabled: true
  - add_fields:
      target: ''
      fields:
        service.name: nginx
        service.type: webserver

logging.level: info
logging.to_files: true
logging.files:
  path: /var/log/filebeat
  name: filebeat
  keepfiles: 7
  permissions: 0644

filebeat.registry.path: /var/lib/filebeat/registry
filebeat.registry.flush: 5s